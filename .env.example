# Đường dẫn SQLite database.
# Trên Railway: thêm volume tại /data, rồi set DATABASE_PATH=/data/xoso.db
# Local dev: bỏ trống — app tự tạo data/xoso.db
DATABASE_PATH=

# Bắt buộc để truy cập /nhap-lieu và các API tạo/sửa/xóa/scrape thủ công.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Bắt buộc cho POST /api/daily-scrape từ GitHub Actions hoặc cron ngoài.
CRON_SECRET=replace-with-an-independent-long-random-secret

# Mặc định false. Chỉ bật khi chạy đúng một instance và không dùng cron ngoài.
AUTO_SCRAPE_ENABLED=false

# Giới hạn request body của adapter-node và timeout mỗi nguồn scrape.
BODY_SIZE_LIMIT=64K
SCRAPE_TIMEOUT_MS=10000
